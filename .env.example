# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ANTHROPIC_MODEL=claude-sonnet-5
DB_PATH=bot.db

# Lock the bot to your own numbers (comma separated, WhatsApp format)
ALLOWED_NUMBERS=whatsapp:+60123456789

# Turn on once you are deployed on a stable https URL
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://your-app.onrender.com/whatsapp
